{
  "name": "pvrge-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "backend:dev": "bun --cwd backend dev",
    "backend:deploy": "bun --cwd backend run deploy",
    "frontend:dev": "bun --cwd frontend dev",
    "frontend:build": "bun --cwd frontend build",
    "deploy": "cd frontend && bun run build && cd ../backend && wrangler deploy"
  },
  "workspaces": [
    "backend",
    "frontend"
  ]
}
