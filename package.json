{
  "name": "pvrge",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "web"
  ],
  "scripts": {
    "build": "cd web && bun run build",
    "dev": "wrangler dev",
    "dev:backend": "wrangler dev",
    "dev:web": "bun --cwd web run dev",
    "db:migrate:local": "wrangler d1 execute pvrge-db --local --file=schema.sql",
    "db:migrate:remote": "wrangler d1 execute pvrge-db --remote --file=schema.sql"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.2.0",
    "elysia": "^1.2.10",
    "postal-mime": "^2.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250204.0",
    "typescript": "^5.7.3",
    "wrangler": "^3.109.1"
  }
}
